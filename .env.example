# Where the API lives. Server-side only — the browser never sees it, because
# requests go to /api/* on this origin and next.config.ts rewrites them.
#
# Must NOT contain a port: the OpenNext adapter matches rewrites with
# path-to-regexp, which reads ":5000" as a path parameter. Fine in production.
API_ORIGIN=

# Absolute URL of this site, used for canonical links and Open Graph.
NEXT_PUBLIC_SITE_URL=
